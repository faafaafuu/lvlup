{
  "expo": {
    "name": "Хрум",
    "slug": "levelup",
    "scheme": "levelup",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon/app-icon-default-1024.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.faraday13.levelup",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSSupportsLiveActivities": true
      },
      "icon": {
        "light": "./assets/icon/app-icon-default-1024.png",
        "dark": "./assets/icon/app-icon-dark-1024.png",
        "tinted": "./assets/icon/app-icon-tinted-1024.png"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.faraday13.levelup"
        ]
      }
    },
    "android": {
      "package": "com.faraday13.levelup"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Хрум слушает фразу о еде или тренировке, чтобы записать её голосом.",
          "speechRecognitionPermission": "Распознавание речи превращает «тарелка плова» в запись."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Хрум читает шаги, сон, вес и тренировки, чтобы засчитывать хорошие дни.",
          "NSHealthUpdateUsageDescription": "Хрум ничего не записывает в Здоровье.",
          "background": false
        }
      ],
      "expo-font",
      "./plugins/withoutPush",
      [
        "./plugins/withSiriShortcut",
        {
          "altNames": [
            "Хрума",
            "Хрумм"
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
