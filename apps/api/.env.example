PORT=3100
# Обязателен, если сервер доступен из интернета. Тот же токен вводится в настройках приложения.
API_TOKEN=
# anthropic | openai | ollama | heuristic
EXTRACTOR=anthropic
LLM_TIMEOUT_MS=6000
DAILY_PARSE_LIMIT=300

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI-совместимый провайдер (EXTRACTOR=openai): OpenAI, OpenRouter, DeepSeek…
# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1, модель вида openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
